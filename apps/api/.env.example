# =============================================================================
# Exemplo de configuração do backend (NestJS) — APENAS PLACEHOLDERS NÃO SECRETOS.
#
# Este arquivo documenta as variáveis reconhecidas pela aplicação. A aplicação
# valida essas variáveis a partir do ambiente do processo (process.env); ela não
# carrega automaticamente um arquivo `.env`. Em desenvolvimento, exporte as
# variáveis no shell ou injete-as via ferramenta de ambiente.
#
# Valores sensíveis devem permanecer vazios ou com placeholders claramente
# inválidos. Nenhuma chave, token, senha ou cookie deve constar aqui.
# =============================================================================

# Ambiente de execução: development | test | production (obrigatório).
NODE_ENV=development

# Porta HTTP do backend (obrigatório; inteiro entre 1 e 65535; escuta em loopback).
PORT=3000

# Origens permitidas para CORS, separadas por vírgula. Cada origem deve ser
# completa (http/https, sem usuário/senha, query, fragment ou caminho além de /).
# Wildcard (*) e a origem especial "null" são proibidos. Em produção, somente
# https é aceito.
CORS_ORIGINS=

# Limite do corpo HTTP em bytes (opcional; inteiro). Padrão conservador:
# 100000 (100 KB). Faixa aceita: 1000 a 1000000 (1 MB). O parser rejeita corpos
# comprimidos e limites de parâmetros em formulários.
BODY_LIMIT_BYTES=

# Janela do rate limit em milissegundos (opcional; inteiro). Padrão: 60000.
# Faixa aceita: 1000 a 3600000 (1 hora).
RATE_LIMIT_TTL_MS=

# Máximo de requisições por janela (opcional; inteiro). Padrão: 100.
# Faixa aceita: 1 a 10000; em produção o teto é 1000 (proteção ineficaz é
# rejeitada no boot). O limiter in-memory vale apenas para instância única.
RATE_LIMIT_MAX=

# Expiração absoluta da sessão em ms (opcional; inteiro). Padrão: 604800000
# (7 dias). Faixa: 3600000 (1 hora) a 2592000000 (30 dias).
SESSION_ABSOLUTE_TTL_MS=

# Expiração por inatividade da sessão em ms (opcional; inteiro). Padrão:
# 1800000 (30 min). Faixa: 300000 (5 min) a 86400000 (24 h). Deve ser menor
# que a expiração absoluta.
SESSION_IDLE_TTL_MS=

# Intervalo mínimo para atualizar lastUsedAt em ms (opcional; inteiro). Padrão:
# 300000 (5 min). Faixa: 60000 (1 min) a 3600000 (60 min). Deve ser menor que a
# expiração por inatividade.
SESSION_TOUCH_INTERVAL_MS=

# URL de conexão do PostgreSQL de desenvolvimento (loopback local).
# Preencha localmente com as credenciais do docker-compose de desenvolvimento
# (protocolo postgresql, host 127.0.0.1, porta do host 5433, banco local de dev).
# Necessária quando a persistência está integrada ao runtime (autenticação).
DATABASE_URL=

# URL do PostgreSQL isolado de TESTES (serviço postgres-test, porta 5434, banco
# leads_test). Usada exclusivamente por comandos e testes; nunca pelo runtime.
DATABASE_URL_TEST=

# Chave da Google Places API. Existirá SOMENTE no backend.
# Preencha localmente com a chave real. NUNCA coloque a chave no frontend, em
# commits, logs, respostas da API ou testes.
# Obrigatória somente quando o runtime do Google Places for implementado.
GOOGLE_PLACES_API_KEY=
