    "@leads/eslint-config": "workspace:*",
    "@leads/typescript-config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.1",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "jest": "30.4.2",
    "prettier": "3.9.6",
