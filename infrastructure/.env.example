# =============================================================================
# Exemplo de configuração da infraestrutura de desenvolvimento - APENAS
# PLACEHOLDERS NÃO SECRETOS.
#
# Copie este arquivo para `.env` na MESMA pasta (infrastructure/.env) e preencha
# com valores locais de desenvolvimento. O `.env` real é ignorado pelo git e
# NUNCA deve ser versionado.
#
# Estes valores alimentam o docker-compose.dev.yml (variáveis obrigatórias com
# sintaxe fail-fast). Use credenciais claramente locais - não reutilize
# credenciais de produção.
# =============================================================================

# Usuário local do PostgreSQL de desenvolvimento.
POSTGRES_USER=leads_dev

# Senha local do PostgreSQL de desenvolvimento (apenas desenvolvimento).
POSTGRES_PASSWORD=change-me

# Nome do banco de dados local de desenvolvimento.
POSTGRES_DB=leads_dev

# Usuário do PostgreSQL isolado de testes (serviço postgres-test, porta 5434).
TEST_POSTGRES_USER=leads_test

# Senha local do PostgreSQL de testes (apenas desenvolvimento/testes).
TEST_POSTGRES_PASSWORD=change-me-test

# Nome do banco de dados local de testes.
TEST_POSTGRES_DB=leads_test
