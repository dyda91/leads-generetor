{
  "name": "@leads/eslint-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ESLint flat configurations (base, React, Node) for the monorepo.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./base": "./base.js",
    "./react": "./react.js",
    "./node": "./node.js"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "typescript-eslint": "8.67.0"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "prettier": "3.9.6"
  }
}
